{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kaleyra CPaaS Messages Video API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Video",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a Kaleyra Video room",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.kaleyra.io/v2/rooms",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a Kaleyra Video (WebRTC) room and returns join details for the listed participants. V1 accounts use POST /room/create."
        }
      ]
    }
  ],
  "bundled": true
}