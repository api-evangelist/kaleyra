                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "urlencoded",
                      "urlencoded": [
                        {
                          "description": "(Required) Recipient MSISDN(s), comma-separated for multiple numbers.",
                          "key": "to",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) Registered sender ID.",
                          "key": "sender",
                          "value": "<string>"
                        },
                        {
                          "description": "Message text (SMS/RCS) or template body.",
